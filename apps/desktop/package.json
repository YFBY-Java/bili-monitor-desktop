{
  "name": "@bmd/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "package:win": "electron-builder --win nsis",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node scripts/prepare-browser-fixtures.ts && vitest run"
  },
  "dependencies": {
    "@bmd/contracts": "workspace:*",
    "@bmd/core-runtime": "workspace:*",
    "@bmd/storage": "workspace:*",
    "@tanstack/react-query": "5.102.0",
    "lucide-react": "1.33.0",
    "playwright": "1.62.1",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "dev.bilimonitor.desktop",
    "productName": "BiliMonitor Desktop",
    "asar": true,
    "directories": {
      "output": "../../release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../.tools/playwright-browsers",
        "to": "playwright-browsers",
        "filter": ["**/*"]
      },
      {
        "from": "../../.tools/python-worker-dist/bmd-python-worker",
        "to": "python-worker",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "BiliMonitor-Desktop-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    }
  }
}
