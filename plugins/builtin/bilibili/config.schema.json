{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.bmd.invalid/plugins/builtin.bilibili/config.schema.json",
  "title": "Bilibili connector configuration",
  "type": "object",
  "properties": {
    "request_timeout_seconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 120,
      "default": 20
