# Development shell overrides only. The application does not load this file automatically.
# Runtime data and exports are accepted only on D:.
BMD_DATA_DIR=D:\BiliMonitor Desktop Data

# Optional Douyin Open Platform OAuth configuration for development.
# Installed applications use D:\BiliMonitor Desktop Data\config\douyin-oauth.env;
# after the next start it is encrypted with Electron safeStorage and the plaintext is removed.
BMD_DOUYIN_OAUTH_MODE=disabled
BMD_DOUYIN_OAUTH_CLIENT_KEY=
BMD_DOUYIN_OAUTH_CLIENT_SECRET=
BMD_DOUYIN_OAUTH_REDIRECT_URI=bilimonitor://douyin-oauth
BMD_DOUYIN_OAUTH_SCOPE=user_info

# Optional Douyin Web browser settings for development; no credential values belong here.
BMD_DOUYIN_HEADLESS=false
BMD_DOUYIN_LOGIN_URL=https://www.douyin.com/
BMD_DOUYIN_VALIDATION_URL=https://www.douyin.com/user/self?from_tab_name=main
BMD_DOUYIN_NAVIGATION_TIMEOUT_MS=30000
BMD_DOUYIN_QR_WAIT_MS=15000
BMD_DOUYIN_LOCALE=zh-CN
BMD_DOUYIN_TIMEZONE_ID=Asia/Shanghai
BMD_DOUYIN_VIEWPORT_WIDTH=1440
BMD_DOUYIN_VIEWPORT_HEIGHT=900
BMD_DOUYIN_USER_AGENT=
BMD_DOUYIN_COOKIE_HEADER_ORIGINS=https://www.douyin.com,https://open.douyin.com
