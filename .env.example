# Optional development override. The default is target/debug/bmd-core.exe.
BMD_CORE_PATH=

# Keep development data inside this checkout. Packaged builds default to the
# operating-system application-data directory unless portable mode is enabled.
BMD_DATA_DIR=.dev-data
BMD_PORTABLE_MODE=false
BMD_LOG=info

# AI is opt-in. Never commit real provider credentials.
BMD_AI_ENABLED=false
BMD_AI_PROVIDER=
BMD_AI_MODEL=
BMD_AI_API_KEY=
