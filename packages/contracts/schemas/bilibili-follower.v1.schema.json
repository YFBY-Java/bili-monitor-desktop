{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilimonitor.local/schemas/bilibili-follower.v1.schema.json",
  "title": "BiliMonitor local Bilibili follower contracts v1",
  "$defs": {
    "FollowerProfileText": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^\u0009-\u000d\u001c-\u0020\u1680\u2000-\u2006\u2008-\u200a\u2028\u2029\u205f\u3000]",
      "description": "Non-Java-blank raw profile text. No trim, URI normalization or VARCHAR bound at the parsing boundary."
    },
    "BilibiliFollowerProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["mid", "nickname"],
      "properties": {
        "mid": { "$ref": "#/$defs/BilibiliUid" },
        "nickname": { "$ref": "#/$defs/FollowerProfileText" }
      }
    },
    "ListBilibiliFollowerMonitorsInput": {
      "type": "object",
      "additionalProperties": false,
      "description": "Omit limit to return all monitors. Explicit bounded callers remain supported.",
      "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 500 } }
    },
    "FollowerHistoryLimit": {
      "type": "integer",
      "default": 500,
      "description": "Input normalization: missing or <=0 becomes 500; positive values are capped at 2000. Output limit is always 1..2000."
    },
    "QueryBilibiliFollowerTrendInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId"],
      "properties": {
        "userId": { "type": "string", "format": "uuid" },
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" },
        "limit": { "$ref": "#/$defs/FollowerHistoryLimit" }
      }
    },
    "QueryBilibiliFollowerTrendsInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userIds": { "type": "array", "items": { "type": "string", "format": "uuid" }, "default": [] },
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" },
        "limitPerUser": { "$ref": "#/$defs/FollowerHistoryLimit" }
      }
    },
    "BilibiliUid": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "ObjectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectId", "relativePath", "sha256", "sizeBytes", "mediaType"],
      "properties": {
        "objectId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "relativePath": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "mediaType": { "type": "string", "minLength": 1 }
      }
    },
    "BilibiliFollowerPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturedAt", "followerCount", "sourceEndpoint"],
      "properties": {
        "capturedAt": { "type": "string", "format": "date-time" },
        "followerCount": { "type": "integer", "minimum": 0 },
        "followingCount": { "type": "integer", "minimum": 0 },
        "sourceEndpoint": { "type": "string", "minLength": 1 }
      }
    },
    "BilibiliFollowerMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mid", "nickname", "profileUrl", "monitorStatus", "intervalSeconds", "recentTrend", "version"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "mid": { "$ref": "#/$defs/BilibiliUid" },
        "nickname": { "$ref": "#/$defs/FollowerProfileText", "maxLength": 160 },
        "avatarUrl": { "$ref": "#/$defs/FollowerProfileText" },
        "profileUrl": { "type": "string", "format": "uri" },
        "currentFollowerCount": { "type": "integer", "minimum": 0 },
        "followingCount": { "type": "integer", "minimum": 0 },
        "deltaSincePrevious": { "type": "integer" },
        "growthRateSincePrevious": { "type": "number" },
        "lastSnapshotAt": { "type": "string", "format": "date-time" },
        "lastSuccessAt": { "type": "string", "format": "date-time" },
        "nextCollectAt": { "type": "string", "format": "date-time" },
        "monitorStatus": { "enum": ["ACTIVE", "PAUSED"] },
        "intervalSeconds": { "type": "integer", "minimum": 1, "maximum": 2592000 },
        "lastErrorType": { "type": "string", "minLength": 1 },
        "lastErrorMessage": { "type": "string", "minLength": 1 },
        "lastErrorAt": { "type": "string", "format": "date-time" },
        "sourceEndpoint": { "type": "string", "minLength": 1 },
        "recentTrend": { "type": "array", "items": { "$ref": "#/$defs/BilibiliFollowerPoint" } },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "AddBilibiliFollowerMonitorInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mid"],
      "properties": {
        "mid": { "$ref": "#/$defs/BilibiliUid" },
        "intervalSeconds": { "type": "integer", "minimum": 1, "maximum": 2592000, "default": 3600 }
      }
    },
    "UpdateBilibiliFollowerMonitorSettingsInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "intervalSeconds"],
      "properties": {
        "userId": { "type": "string", "format": "uuid" },
        "intervalSeconds": { "type": "integer", "minimum": 1, "maximum": 2592000 }
      }
    },
    "BilibiliFollowerHttpConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connectTimeoutMs": { "type": "integer", "minimum": 0, "maximum": 2147483647, "default": 5000 },
        "readTimeoutMs": { "type": "integer", "minimum": 0, "maximum": 2147483647, "default": 10000 },
        "userAgent": { "type": "string", "pattern": "^[\\t\\u0020-\\u007e]*$", "not": { "pattern": "[^\\t\\u0020-\\u007e]" }, "default": "SocialDataMonitor/0.1 (+low-frequency public Bilibili follower monitor)" },
        "referer": { "type": "string", "pattern": "^[\\t\\u0020-\\u007e]*$", "not": { "pattern": "[^\\t\\u0020-\\u007e]" }, "default": "https://www.bilibili.com/" }
      }
    },
    "BilibiliFollowerFetchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "attempt", "leaseId", "mid"],
      "properties": {
        "httpConfiguration": { "$ref": "#/$defs/BilibiliFollowerHttpConfiguration" },
        "taskId": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "leaseId": { "type": "string", "minLength": 1 },
        "mid": { "$ref": "#/$defs/BilibiliUid" }
      }
    },
    "BilibiliFollowerFetchedSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mid", "profileUrl", "followerCount", "fetchedAt", "sourceEndpoint", "evidenceObject", "statusCode", "durationMs"],
      "properties": {
        "mid": { "$ref": "#/$defs/BilibiliUid" },
        "nickname": { "$ref": "#/$defs/FollowerProfileText" },
        "avatarUrl": { "$ref": "#/$defs/FollowerProfileText" },
        "profileUrl": { "type": "string", "format": "uri" },
        "followerCount": { "type": "integer", "minimum": 0 },
        "followingCount": { "type": "integer", "minimum": 0 },
        "fetchedAt": { "type": "string", "format": "date-time" },
        "sourceEndpoint": { "enum": ["x/web-interface/card", "x/relation/stat"] },
        "evidenceObject": { "$ref": "#/$defs/ObjectRef" },
        "statusCode": { "type": "integer", "minimum": 1 },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
