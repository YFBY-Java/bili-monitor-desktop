{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilimonitor.local/schemas/runtime-envelope.v1.schema.json",
  "title": "BiliMonitor Runtime Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "version", "timestamp", "correlationId", "traceId", "payload"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "version": { "const": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1 },
    "causationId": { "type": "string", "minLength": 1 },
    "traceId": { "type": "string", "minLength": 1 },
    "payload": {}
  }
}
