{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilimonitor.local/schemas/bilibili-follower.v2.schema.json",
  "title": "BiliMonitor local bilibili-follower contracts v2",
  "$defs": {
