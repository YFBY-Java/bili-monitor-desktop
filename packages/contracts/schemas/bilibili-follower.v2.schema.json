    },
    "PositiveJavaLongString": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|9223372036854775807|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6])(?![\\s\\S])"
    },
    "BilibiliFollowerProfileV2": {
      "type": "object",
      "properties": {
        "mid": {
          "$ref": "#/$defs/JavaLongString"
        },
        "nickname": {
          "type": "string",
          "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]"
        }
      },
      "required": [
        "mid",
        "nickname"
      ],
      "additionalProperties": false
    },
    "BilibiliFollowerPointV2": {
      "type": "object",
      "properties": {
        "capturedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9](?:\\.[0-9]+)?)?(?:Z))$"
        },
        "followerCount": {
          "$ref": "#/$defs/JavaLongString"
        },
        "followingCount": {
          "$ref": "#/$defs/JavaLongString"
        },
        "sourceEndpoint": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "capturedAt",
        "followerCount",
        "sourceEndpoint"
      ],
      "additionalProperties": false
    },
    "BilibiliFollowerMonitorV2": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "mid": {
          "$ref": "#/$defs/PositiveJavaLongString"
        },
        "nickname": {
          "type": "string",
          "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]",
          "maxLength": 160
        },
        "avatarUrl": {
          "type": "string",
          "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]"
        },
        "profileUrl": {
          "type": "string",
          "format": "uri"
        },
        "currentFollowerCount": {
          "$ref": "#/$defs/JavaLongString"
        },
        "followingCount": {
          "$ref": "#/$defs/JavaLongString"
        },
        "deltaSincePrevious": {
          "$ref": "#/$defs/JavaLongString"
        },
        "growthRateSincePrevious": {
          "type": "number"
        },
        "lastSnapshotAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9](?:\\.[0-9]+)?)?(?:Z))$"
        },
        "lastSuccessAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9](?:\\.[0-9]+)?)?(?:Z))$"
        },
        "nextCollectAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9](?:\\.[0-9]+)?)?(?:Z))$"
        },
        "monitorStatus": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "PAUSED"
          ]
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2592000
        },
        "lastErrorType": {
          "type": "string",
          "minLength": 1
        },
        "lastErrorMessage": {
          "type": "string",
          "minLength": 1
        },
        "lastErrorAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9](?:\\.[0-9]+)?)?(?:Z))$"
        },
        "sourceEndpoint": {
          "type": "string",
          "minLength": 1
        },
        "recentTrend": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BilibiliFollowerPointV2"
          }
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "mid",
        "nickname",
        "profileUrl",
        "monitorStatus",
        "intervalSeconds",
        "recentTrend",
        "version"
      ],
      "additionalProperties": false
